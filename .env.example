SUWAPPU_API_KEY=suwappu_sk_your_api_key_here

# Required only for --execute so the route can be simulated before submission.
SUWAPPU_WALLET_ADDRESS=0x_your_managed_wallet_address

# Managed execution requires this to be exactly 1 in addition to --execute.
SUWAPPU_ALLOW_MANAGED_EXECUTION=0

# Client-side ceiling for each candidate action. This reference is USDC-only.
SUWAPPU_MAX_TRADE_USDC=1000

# Optional local journal location. Docker Compose overrides this with /data on
# its persistent named volume.
# SUWAPPU_TRADING_BOT_STATE_DIR=./state

# Optional journal retention target. Only failed/accounted records are pruned;
# unresolved execution/idempotency records are never removed by retention.
# SUWAPPU_TRADING_BOT_JOURNAL_LIMIT=5000

# Bound each Suwappu operation (100-30000ms). Managed timeouts remain
# outcome-unknown and must be reconciled, never treated as a proven failure.
# SUWAPPU_OPERATION_TIMEOUT_MS=25000

# Metadata-only API timing/outcome events. Never includes keys, wallet/market
# terms, quote/swap IDs, response bodies, or error text.
# SUWAPPU_API_EVENTS=1

# Optional for local/self-hosted API development.
# SUWAPPU_API_URL=https://api.suwappu.bot
